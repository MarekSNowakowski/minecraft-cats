{
	"schemaVersion": 1,
	"id": "meowdifications",
	"version": "${version}",
	"name": "Meowdifications",
	"description": "Enhances Minecraft cats with cozy cat beds, scratching posts, litter boxes, interactive toys, and enriched feline behaviors and player interactions.",
	"authors": [
		"Marek 'Keroen' Nowakowski"
	],
	"contact": {
		"homepage": "https://mareksnowakowski.github.io/projects/meowdifications/",
		"sources": "https://mareksnowakowski.github.io/projects/meowdifications/"
	},
	"license": "MIT",
	"icon": "assets/meowdifications/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.keroen.meowdifications.Meowdifications"
		],
		"client": [
			"com.keroen.meowdifications.client.MeowdificationsClient"
		],
		"fabric-datagen": [
			"com.keroen.meowdifications.client.MeowdificationsDataGenerator"
		]
	},
	"mixins": [
		"meowdifications.mixins.json",
		{
			"config": "meowdifications.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}